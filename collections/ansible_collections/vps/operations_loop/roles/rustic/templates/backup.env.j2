# Rustic 环境变量配置
# 位置: /etc/rustic/backup.env

# 密码配置
RUSTIC_PASSWORD="{{ vault_rustic_password }}"

BACKUP_SOURCE_DOCKER_DIR={{ rustic_backup_source_docker_dir }}
{% if ansible_system == 'Darwin' %}
BACKUP_LOCAL_PREFIX={{ rustic_darwin_local_repo }}
BACKUP_EXCLUDE_FILE={{ rustic_darwin_config_dir }}/exclude.txt
RUSTIC_LOCK_FILE={{ rustic_darwin_run_dir }}/rustic.lock
RUSTIC_CLEANUP_SUCCESS_MARKER={{ rustic_darwin_run_dir }}/cleanup-success.json
RCLONE_CONFIG={{ rustic_rclone_config_path }}
{% else %}
BACKUP_LOCAL_PREFIX={{ rustic_backup_base_dir }}/complete
BACKUP_EXCLUDE_FILE=/etc/rustic/exclude.txt
RUSTIC_LOCK_FILE={{ rustic_lock_file }}
RUSTIC_CLEANUP_SUCCESS_MARKER={{ rustic_cleanup_success_marker }}
{% endif %}
BACKUP_CLOUD_REMOTES={{ rustic_backup_cloud_remotes | join(',') }}
BACKUP_CLOUD_PREFIX={{ rustic_backup_cloud_prefix }}
BACKUP_SRC_PATHS={{ (rustic_backup_src_paths + rustic_backup_src_paths_extra) | unique | join(',') }}
RUSTIC_FORGET_TIMEOUT_SECONDS={{ rustic_forget_timeout_seconds }}
RUSTIC_LOCK_TIMEOUT={{ rustic_lock_timeout | default(180) }}

# 日志配置
{% if ansible_system == 'Darwin' %}
RUSTIC_LOG_FILE={{ rustic_darwin_log_dir }}/rustic_backup.log
{% else %}
RUSTIC_LOG_FILE={{ rustic_log_dir }}/rustic_backup.log
{% endif %}

# 保留策略
BACKUP_RETENTION_10MIN={{ rustic_backup_retention_10min | default(3) }}
BACKUP_RETENTION_DAILY={{ rustic_backup_retention_daily | default(1) }}
BACKUP_RETENTION_WEEKLY={{ rustic_backup_retention_weekly | default(1) }}
BACKUP_RETENTION_MONTHLY={{ rustic_backup_retention_monthly | default(1) }}
BACKUP_RETENTION_YEARLY={{ rustic_backup_retention_yearly | default(1) }}

# 数据库密码
{% if rustic_postgresql_db_admin_password is defined and rustic_postgresql_db_admin_password | length > 0 %}
POSTGRESQL_DB_ADMIN_PASSWORD="{{ rustic_postgresql_db_admin_password }}"
{% endif %}
{% if rustic_redis_db_admin_password is defined and rustic_redis_db_admin_password | length > 0 %}
REDIS_DB_ADMIN_PASSWORD="{{ rustic_redis_db_admin_password }}"
{% endif %}
