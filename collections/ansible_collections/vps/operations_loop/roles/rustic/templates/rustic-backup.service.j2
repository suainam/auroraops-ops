[Unit]
Description={{ rustic_service_description | default('Rustic ' ~ rustic_backup_mode ~ ' repository operation') }}
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root
EnvironmentFile=/etc/rustic/backup.env
ExecStart={{ python_executor }} /usr/local/bin/rustic_backup.py {{ rustic_backup_mode }}
TimeoutStartSec={{ rustic_backup_service_timeout }}
SuccessExitStatus=75
